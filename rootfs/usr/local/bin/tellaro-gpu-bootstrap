#!/usr/bin/env python3
"""tellaro-gpu-bootstrap: key pair, bootstrap redemption, renewal and health.

Design: tellaro-docs internal/platform/runpod-gpu-pools.md sections 3.3 and 3.4.
Wire contract: tellaro-backend#3047 (B3), src/customer_portal/api/gpu_pool/
bootstrap_routes.py (redeem) and client.py (renew).

Subcommands
  keygen   P-256 key (mode 0600, container disk only) and a CSR.
  redeem   POST /api/v1/gpu_pool/bootstrap, check the answer, unseal, write files.
  serve    loopback helper behind Caddy for /_tellaro/{health,renew,renew/certificate}.

Files `redeem` writes (the entrypoint's contract, internal to this image):
  <tls-dir>/server.crt          server leaf + GPU pool CA from the backend
  <tls-dir>/client-ca.pem       GPU pool CA bundle (current + previous)
  <secrets-dir>/vllm-api-key    unsealed vLLM API key
  <secrets-dir>/hf-token        unsealed HF token, only if the answer carries one
  <launch-dir>/vllm-args.json   JSON list of `vllm serve` args from the profile,
                                after check_profile_args()

Never log a token, a CSR, a key or anything unsealed.
"""

from __future__ import annotations

import argparse
import base64
import http.client
import http.server
import json
import os
import random
import ssl
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid

EX_CONFIG = 78  # sysexits: "not configured"

TERMINATOR_PORT = 8443
SERVER_NAME_SUFFIX = "gpu.tellaro.internal"
#: The token's TTL (section 3.3 step 1): retrying past it cannot succeed.
REDEEM_DEADLINE_SECONDS = 30 * 60
#: Answers the backend marks as "try again" (section 3.3 step 3, plus CA/RunPod/OpenSearch outages).
RETRYABLE_STATUS = frozenset({425, 429, 500, 502, 503, 504})
MAX_ANSWER_BYTES = 1 << 20
MAX_PUSH_BYTES = 64 << 10

# seal_v2 raw-key format (tellaro-backend src/customer_portal/api/seal_v2.py, seal_to_key).
SEAL_PREFIX = "s2$"
SEAL_INFO = b"tellaro-seal-v2"
SEAL_RAW_AAD = b"tellaro-seal-v2/raw"
SEAL_IV_LENGTH = 12

# Flags a launch profile may never pass: they would move vLLM off loopback,
# replace the API key, or turn on request/output logging.
DENIED_FLAG_PREFIXES = (
    "--host",
    "--port",
    "--uds",
    "--api-key",
    "--enable-log-requests",
    "--enable-log-outputs",
    "--log-config-file",
    "--ssl-",
    "--allowed-origins",
    "--root-path",
)


def log(msg: str) -> None:
    print(f"tellaro-gpu-bootstrap: {msg}", file=sys.stderr, flush=True)


def write_private(path: str, data: bytes) -> None:
    """Write a file readable only by this uid, never via a world-readable temp."""
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        os.write(fd, data)
    finally:
        os.close(fd)
    os.chmod(path, 0o600)


def replace_private(path: str, data: bytes) -> None:
    """Swap a file in atomically (same directory), so Caddy never reads half of it."""
    tmp = f"{path}.new"
    write_private(tmp, data)
    os.replace(tmp, path)


def check_profile_args(args: list[str]) -> list[str]:
    """Reject launch-profile args that would weaken the image's fixed settings."""
    if not isinstance(args, list) or not all(isinstance(a, str) for a in args):
        raise ValueError("launch profile args must be a list of strings")
    for a in args:
        flag = a.split("=", 1)[0]
        if any(flag.startswith(p) for p in DENIED_FLAG_PREFIXES):
            raise ValueError(f"launch profile may not set {flag}")
    return args


def _value(name: str, v: object, kind: type) -> str:
    """One profile value as a `vllm serve` argument; never something that parses as a flag."""
    if kind is int and (isinstance(v, bool) or not isinstance(v, int) or v < 1):
        raise ValueError(f"launch profile {name} must be a positive integer")
    if kind is float and (isinstance(v, bool) or not isinstance(v, (int, float)) or not 0 < v < 1):
        raise ValueError(f"launch profile {name} must be a number between 0 and 1")
    if kind is str and (not isinstance(v, str) or not v or v.startswith("-") or any(c.isspace() for c in v)):
        raise ValueError(f"launch profile {name} must be a non-empty token")
    return str(v)


def profile_to_args(model: object) -> list[str]:
    """`vllm serve` args from the answer's ``model`` ({model_id, launch_profile}, backend ``_launch``).

    The profile fields are the backend's ``LaunchProfile``: ``tp``,
    ``max_model_len``, ``gpu_memory_utilization``, ``quantization``,
    ``checkpoint`` (served under the model id) and ``weights_gb`` (fit check
    only). Unknown fields are ignored: only the mapped ones become arguments.
    """
    if not isinstance(model, dict):
        raise ValueError("the answer has no model")
    model_id = _value("model_id", model.get("model_id"), str)
    profile = model.get("launch_profile")
    profile = {} if profile is None else profile
    if not isinstance(profile, dict):
        raise ValueError("launch_profile must be an object")
    checkpoint = profile.get("checkpoint")
    args = [_value("checkpoint", checkpoint, str), "--served-model-name", model_id] if checkpoint else [model_id]
    for field, flag, kind in (
        ("tp", "--tensor-parallel-size", int),
        ("max_model_len", "--max-model-len", int),
        ("gpu_memory_utilization", "--gpu-memory-utilization", float),
        ("quantization", "--quantization", str),
    ):
        if profile.get(field) is not None:
            args += [flag, _value(field, profile[field], kind)]
    return check_profile_args(args)


def canonical_run_id(run_id: str) -> str:
    """The run uuid as the backend binds it: 32 lowercase hex characters."""
    return uuid.UUID(run_id).hex


def open_sealed(wire: str, key: object, binding: str) -> str:
    """Open a ``seal_v2`` raw-key value (backend ``seal_v2.seal_to_key``) with this pod's key.

    ``Z = ECDH(key, E)``, HKDF-SHA256(``Z``, salt ``E || K`` compressed, info
    ``tellaro-seal-v2``), AES-256-GCM with AAD ``tellaro-seal-v2/raw || binding``.
    """
    from cryptography.hazmat.primitives import hashes, serialization
    from cryptography.hazmat.primitives.asymmetric import ec
    from cryptography.hazmat.primitives.ciphers.aead import AESGCM
    from cryptography.hazmat.primitives.kdf.hkdf import HKDF

    if not isinstance(key, ec.EllipticCurvePrivateKey):
        raise ValueError("sealed values open only with an EC key")
    if not isinstance(wire, str) or not wire.startswith(SEAL_PREFIX):
        raise ValueError("not a seal_v2 value")
    raw = base64.b64decode(wire[len(SEAL_PREFIX) :], validate=True)
    point_len = (key.curve.key_size + 7) // 8 + 1
    if len(raw) < point_len + SEAL_IV_LENGTH + 16:
        raise ValueError("sealed value is too short")
    e_point, iv, ct = raw[:point_len], raw[point_len : point_len + SEAL_IV_LENGTH], raw[point_len + SEAL_IV_LENGTH :]
    ephemeral = ec.EllipticCurvePublicKey.from_encoded_point(key.curve, e_point)
    k_point = key.public_key().public_bytes(serialization.Encoding.X962, serialization.PublicFormat.CompressedPoint)
    aes_key = HKDF(algorithm=hashes.SHA256(), length=32, salt=e_point + k_point, info=SEAL_INFO).derive(
        key.exchange(ec.ECDH(), ephemeral)
    )
    aad = SEAL_RAW_AAD + binding.replace("-", "").lower().encode("ascii")
    return AESGCM(aes_key).decrypt(iv, ct, aad).decode("utf-8")


def _spki(public_key: object) -> bytes:
    from cryptography.hazmat.primitives import serialization

    return public_key.public_bytes(  # type: ignore[attr-defined]
        serialization.Encoding.DER, serialization.PublicFormat.SubjectPublicKeyInfo
    )


def check_chain(chain_pem: object, key: object, server_name: str | None = None) -> None:
    """The pushed/answered server chain is for *this* key (and name), and the leaf is in date."""
    import datetime

    from cryptography import x509

    if not isinstance(chain_pem, str) or not chain_pem.strip():
        raise ValueError("no certificate chain")
    certs = x509.load_pem_x509_certificates(chain_pem.encode())
    leaf = certs[0]
    if _spki(leaf.public_key()) != _spki(key.public_key()):  # type: ignore[attr-defined]
        raise ValueError("the server certificate is not for this pod's key")
    utc = datetime.timezone.utc
    now = datetime.datetime.now(utc)
    # *_utc needs cryptography 42+; the naive fields are UTC too.
    before = getattr(leaf, "not_valid_before_utc", None) or leaf.not_valid_before.replace(tzinfo=utc)
    after = getattr(leaf, "not_valid_after_utc", None) or leaf.not_valid_after.replace(tzinfo=utc)
    if not before <= now < after:
        raise ValueError("the server certificate is not valid now")
    if server_name is not None:
        names = leaf.extensions.get_extension_for_class(x509.SubjectAlternativeName).value
        if server_name not in names.get_values_for_type(x509.DNSName):
            raise ValueError("the server certificate does not name this run")


def check_bundle(bundle_pem: object) -> None:
    from cryptography import x509

    if not isinstance(bundle_pem, str) or not bundle_pem.strip():
        raise ValueError("no client CA bundle")
    x509.load_pem_x509_certificates(bundle_pem.encode())


def new_key_and_csr(run_id: str) -> tuple[object, bytes, bytes]:
    """A P-256 key (PEM, PKCS8) and a CSR whose subject is the run id."""
    from cryptography import x509
    from cryptography.hazmat.primitives import hashes, serialization
    from cryptography.hazmat.primitives.asymmetric import ec
    from cryptography.x509.oid import NameOID

    key = ec.generate_private_key(ec.SECP256R1())
    key_pem = key.private_bytes(
        serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8, serialization.NoEncryption()
    )
    # The backend sets the SANs itself and ignores the CSR's (section 3.3,
    # step 4), so the CSR carries only a subject for the audit trail.
    csr = (
        x509.CertificateSigningRequestBuilder()
        .subject_name(x509.Name([x509.NameAttribute(NameOID.COMMON_NAME, run_id)]))
        .sign(key, hashes.SHA256())
    )
    return key, key_pem, csr.public_bytes(serialization.Encoding.PEM)


def load_key(path: str) -> object:
    from cryptography.hazmat.primitives import serialization

    with open(path, "rb") as f:
        return serialization.load_pem_private_key(f.read(), password=None)


# --------------------------------------------------------------------------
# keygen
# --------------------------------------------------------------------------
def cmd_keygen(ns: argparse.Namespace) -> int:
    run_id = os.environ.get("TELLARO_RUN_ID", "")
    if not run_id:
        log("TELLARO_RUN_ID is not set")
        return 1
    _key, key_pem, csr_pem = new_key_and_csr(run_id)
    write_private(os.path.join(ns.out, "server.key"), key_pem)
    write_private(os.path.join(ns.out, "server.csr"), csr_pem)
    log("generated P-256 key and CSR")
    return 0


# --------------------------------------------------------------------------
# redeem
# --------------------------------------------------------------------------
class Refused(Exception):
    """The backend refused for good (401, 409, 422...): retrying cannot help."""


def _post_bootstrap(url: str, body: bytes, ctx: ssl.SSLContext) -> tuple[int, dict, float | None]:
    req = urllib.request.Request(url, data=body, method="POST", headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=60, context=ctx) as r:
            return r.status, json.loads(r.read(MAX_ANSWER_BYTES)), None
    except urllib.error.HTTPError as e:
        retry_after: float | None = None
        try:
            retry_after = float(e.headers.get("Retry-After") or "")
        except ValueError:
            pass
        code = ""
        try:
            code = str(json.loads(e.read(4096)).get("code") or "")
        except (ValueError, AttributeError, OSError):
            pass
        if e.code not in RETRYABLE_STATUS:
            raise Refused(f"HTTP {e.code} {code}".strip()) from None
        return e.code, {"code": code}, retry_after


def redeem(url: str, run_id: str, token: str, csr_pem: str, deadline: float) -> dict:
    """POST the bootstrap request until it is answered, refused, or the token's TTL runs out.

    A same-key retry is safe: the backend answers it again (B3 ``redeem``).
    """
    if urllib.parse.urlsplit(url).scheme != "https":
        raise Refused("TELLARO_BOOTSTRAP_URL must be https")
    # Normal public-TLS verification (section 3.3 step 2); SSL_CERT_FILE applies as usual.
    ctx = ssl.create_default_context()
    ctx.minimum_version = ssl.TLSVersion.TLSv1_2
    body = json.dumps({"run_id": run_id, "token": token, "csr": csr_pem}).encode()
    attempt = 0
    while True:
        attempt += 1
        try:
            status, answer, retry_after = _post_bootstrap(url, body, ctx)
        except (urllib.error.URLError, http.client.HTTPException, OSError, ValueError) as e:
            status, answer, retry_after = 0, {"code": type(e).__name__}, None
        if status == 200:
            return answer
        wait = retry_after if retry_after and 0 < retry_after <= 300 else min(60.0, 2.0**attempt)
        wait += random.uniform(0, 1)
        if time.monotonic() + wait > deadline:
            raise Refused(f"not answered before the token expired (last: {status} {answer.get('code', '')})")
        log(f"bootstrap not ready ({status} {answer.get('code', '')}); retrying in {wait:.0f}s")
        time.sleep(wait)


def write_answer(answer: dict, key: object, run_id: str, ns: argparse.Namespace) -> None:
    """Check the answer against this pod's key and run, then write the entrypoint's files."""
    canonical = canonical_run_id(run_id)
    if answer.get("run_id") != canonical:
        raise ValueError("the answer is for another run")
    server_name = f"{canonical}.{SERVER_NAME_SUFFIX}"
    if answer.get("server_name") != server_name:
        raise ValueError("the answer names another server")
    if answer.get("terminator_port") != TERMINATOR_PORT:
        raise ValueError(
            f"the backend expects the terminator on {answer.get('terminator_port')}, not {TERMINATOR_PORT}"
        )
    check_chain(answer.get("certificate_chain"), key, server_name)
    check_bundle(answer.get("client_ca_bundle"))
    sealed = answer.get("sealed")
    if not isinstance(sealed, dict) or not sealed.get("vllm_api_key"):
        raise ValueError("the answer has no sealed vLLM API key")
    api_key = open_sealed(sealed["vllm_api_key"], key, canonical)
    hf_token = open_sealed(sealed["hf_token"], key, canonical) if sealed.get("hf_token") else None
    args = profile_to_args(answer.get("model"))

    write_private(os.path.join(ns.tls_dir, "server.crt"), answer["certificate_chain"].encode())
    write_private(os.path.join(ns.tls_dir, "client-ca.pem"), answer["client_ca_bundle"].encode())
    write_private(os.path.join(ns.secrets_dir, "vllm-api-key"), api_key.encode())
    if hf_token:
        write_private(os.path.join(ns.secrets_dir, "hf-token"), hf_token.encode())
    write_private(os.path.join(ns.launch_dir, "vllm-args.json"), json.dumps(args).encode())


def cmd_redeem(ns: argparse.Namespace) -> int:
    url = os.environ.get("TELLARO_BOOTSTRAP_URL", "")
    run_id = os.environ.get("TELLARO_RUN_ID", "")
    token = os.environ.get("TELLARO_BOOTSTRAP_TOKEN", "")
    if not (url and run_id and token):
        log("TELLARO_BOOTSTRAP_URL, TELLARO_RUN_ID and TELLARO_BOOTSTRAP_TOKEN are required")
        return EX_CONFIG
    try:
        canonical_run_id(run_id)
        key = load_key(os.path.join(ns.tls_dir, "server.key"))
        with open(os.path.join(ns.tls_dir, "server.csr")) as f:
            csr_pem = f.read()
        answer = redeem(url, run_id, token, csr_pem, time.monotonic() + ns.deadline)
        write_answer(answer, key, run_id, ns)
    except Refused as e:
        log(f"bootstrap refused: {e}")
        return EX_CONFIG
    except Exception as e:  # noqa: BLE001 - any bad answer (incl. cryptography's InvalidTag) fails closed
        # Only the type and a fixed message: nothing from the answer or the secrets.
        detail = f": {e}" if isinstance(e, ValueError) and type(e) is ValueError else ""
        log(f"bootstrap answer rejected: {type(e).__name__}{detail}")
        return 1
    log("bootstrap redeemed")
    return 0


# --------------------------------------------------------------------------
# serve: /_tellaro/health, /_tellaro/renew, /_tellaro/renew/certificate
# --------------------------------------------------------------------------
class Handler(http.server.BaseHTTPRequestHandler):
    vllm_base = "http://127.0.0.1:8000"
    tls_dir = "/run/tellaro/tls"
    run_id = ""
    reload_cmd: list[str] = []
    server_version = "tellaro-gpu-bootstrap"
    sys_version = ""
    # The key of the last /_tellaro/renew, waiting for its certificate. Only the
    # newest CSR's certificate is accepted.
    pending_key: object = None
    lock = threading.Lock()

    def log_message(self, format: str, *args: object) -> None:  # noqa: A002
        pass  # no access log

    def _send(self, code: int, body: dict) -> None:
        data = json.dumps(body).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)
        self.wfile.flush()

    def do_GET(self) -> None:  # noqa: N802
        if self.path != "/_tellaro/health":
            self._send(404, {"error": "not found"})
            return
        try:
            with urllib.request.urlopen(f"{self.vllm_base}/health", timeout=5) as r:
                ok = r.status == 200
        except (urllib.error.URLError, OSError):
            ok = False
        self._send(200 if ok else 503, {"vllm": "up" if ok else "down"})

    def do_POST(self) -> None:  # noqa: N802
        if self.path == "/_tellaro/renew":
            self._renew()
        elif self.path == "/_tellaro/renew/certificate":
            self._renew_certificate()
        else:
            self._send(404, {"error": "not found"})

    def _renew(self) -> None:
        """Section 3.4 step 1: a fresh key (kept here) and its CSR for the backend to sign."""
        key, _key_pem, csr_pem = new_key_and_csr(self.run_id)
        with Handler.lock:
            Handler.pending_key = key
        self._send(200, {"csr": csr_pem.decode()})

    def _renew_certificate(self) -> None:
        """Steps 3 and 4: take the pushed chain and CA bundle for the pending key, then reload Caddy."""
        try:
            length = int(self.headers.get("Content-Length") or 0)
            if not 0 < length <= MAX_PUSH_BYTES:
                raise ValueError("bad body length")
            push = json.loads(self.rfile.read(length))
            if not isinstance(push, dict):
                raise ValueError("body must be an object")
        except ValueError:
            self._send(400, {"error": "bad request"})
            return
        from cryptography.hazmat.primitives import serialization

        with Handler.lock:
            key = Handler.pending_key
            if key is None:
                self._send(409, {"error": "no renewal pending"})
                return
            try:
                check_chain(push.get("certificate_chain"), key, f"{canonical_run_id(self.run_id)}.{SERVER_NAME_SUFFIX}")
                check_bundle(push.get("client_ca_bundle"))
            except ValueError as e:
                self._send(409, {"error": str(e)})
                return
            key_pem = key.private_bytes(  # type: ignore[attr-defined]
                serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8, serialization.NoEncryption()
            )
            # Key first: until the reload Caddy keeps serving the old pair it already loaded.
            replace_private(os.path.join(self.tls_dir, "server.key"), key_pem)
            replace_private(os.path.join(self.tls_dir, "server.crt"), push["certificate_chain"].encode())
            replace_private(os.path.join(self.tls_dir, "client-ca.pem"), push["client_ca_bundle"].encode())
            Handler.pending_key = None
        self._send(200, {"status": "accepted"})
        # Reload after answering: this request is itself proxied by the Caddy being reloaded.
        threading.Thread(target=reload_caddy, args=(self.reload_cmd,), daemon=True).start()


def reload_caddy(cmd: list[str]) -> None:
    """Reload Caddy over its admin unix socket. If that fails, exit so the pod is recycled (section 3.4)."""
    time.sleep(0.2)
    try:
        subprocess.run(cmd, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, timeout=60)
    except (subprocess.SubprocessError, OSError) as e:
        log(f"caddy reload failed after a renewal ({type(e).__name__}); exiting so the run is replaced")
        os._exit(1)
    log("renewed server certificate; caddy reloaded")


def cmd_serve(ns: argparse.Namespace) -> int:
    host, _, port = ns.listen.rpartition(":")
    if host not in ("127.0.0.1", "::1", "localhost"):
        log("refusing to listen off loopback")
        return 1
    run_id = os.environ.get("TELLARO_RUN_ID", "")
    try:
        canonical_run_id(run_id)
    except ValueError:
        log("TELLARO_RUN_ID must be the run uuid")
        return 1
    Handler.vllm_base = ns.vllm.rstrip("/")
    Handler.tls_dir = ns.tls_dir
    Handler.run_id = run_id
    Handler.reload_cmd = [
        ns.caddy,
        "reload",
        "--config",
        ns.caddy_config,
        "--adapter",
        "caddyfile",
        "--address",
        ns.caddy_admin,
        # The config text is unchanged; only the files behind it are new.
        "--force",
    ]
    srv = http.server.ThreadingHTTPServer((host, int(port)), Handler)
    log(f"helper listening on {ns.listen}")
    srv.serve_forever()
    return 0


def main(argv: list[str]) -> int:
    p = argparse.ArgumentParser(prog="tellaro-gpu-bootstrap")
    sub = p.add_subparsers(dest="cmd", required=True)
    k = sub.add_parser("keygen")
    k.add_argument("--out", required=True)
    r = sub.add_parser("redeem")
    r.add_argument("--tls-dir", required=True)
    r.add_argument("--secrets-dir", required=True)
    r.add_argument("--launch-dir", required=True)
    r.add_argument("--deadline", type=float, default=REDEEM_DEADLINE_SECONDS, help=argparse.SUPPRESS)
    s = sub.add_parser("serve")
    s.add_argument("--listen", default="127.0.0.1:8001")
    s.add_argument("--vllm", default="http://127.0.0.1:8000")
    s.add_argument("--tls-dir", required=True)
    s.add_argument("--caddy", default="caddy")
    s.add_argument("--caddy-config", default="/etc/tellaro/Caddyfile")
    s.add_argument("--caddy-admin", default="unix//run/tellaro/caddy-admin.sock")
    ns = p.parse_args(argv)
    return {"keygen": cmd_keygen, "redeem": cmd_redeem, "serve": cmd_serve}[ns.cmd](ns)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
